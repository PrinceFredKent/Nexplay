rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email != null && (
        request.auth.token.email.lower() == 'taxwiseplatform@gmail.com' ||
        request.auth.token.email.lower() == 'princefredkent@gmail.com'
      );
    }

    // Connection Healthcheck Document (mandated by firebase skill)
    match /test/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // User Profile Document and personal subcollections
    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId) || isAdmin();

      // Watchlist subcollection
      match /watchlist/{mediaId} {
        allow read, create, update, delete: if isOwner(userId) || isAdmin();
      }

      // Favorites subcollection
      match /favorites/{mediaId} {
        allow read, create, update, delete: if isOwner(userId) || isAdmin();
      }

      // Watch History subcollection
      match /history/{mediaId} {
        allow read, create, update, delete: if isOwner(userId) || isAdmin();
      }
    }

    // Global Movie & TV Catalog
    match /catalog/{mediaId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Deleted movies blacklist / records
    match /deleted_movies/{mediaId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // System configuration & stats
    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
